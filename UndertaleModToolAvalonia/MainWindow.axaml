<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UndertaleModToolAvalonia.MainWindow"
        Title="UndertaleModTool"
        Icon="avares://UndertaleModTool/Assets/icon.ico"
        Width="1280" Height="800"
        MinWidth="640" MinHeight="400"
        DragDrop.AllowDrop="True">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Click="New_Click" />
                <MenuItem Header="_Open..." InputGesture="Ctrl+O" Click="Open_Click" />
                <MenuItem x:Name="RecentMenu" Header="Open _recent" />
                <MenuItem x:Name="SaveMenuItem" Header="_Save" InputGesture="Ctrl+S" Click="Save_Click" />
                <MenuItem x:Name="SaveAsMenuItem" Header="Save _as..." InputGesture="Ctrl+Shift+S" Click="SaveAs_Click" />
                <MenuItem x:Name="CloseMenuItem" Header="_Close file" Click="CloseFile_Click" />
                <Separator />
                <MenuItem Header="Open containing _folder" Click="OpenFolder_Click" />
                <MenuItem Header="Se_ttings..." Click="Settings_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Search in code..." InputGesture="Ctrl+Shift+F" Click="SearchInCode_Click" />
                <MenuItem Header="_Go to tree filter" InputGesture="Ctrl+F" Click="FocusFilter_Click" />
                <Separator />
                <MenuItem Header="Close _tab" InputGesture="Ctrl+W" Click="CloseTab_Click" />
                <MenuItem Header="_Refresh tree" InputGesture="F5" Click="RefreshTree_Click" />
            </MenuItem>
            <MenuItem x:Name="ScriptsMenu" Header="_Scripts" />
            <MenuItem Header="_Help">
                <MenuItem Header="_GitHub" Click="GitHub_Click" />
                <MenuItem Header="_About" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- Command box / status bar, like the Windows GUI's command box -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="6,4">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Run" Click="RunCommand_Click" Margin="6,0,0,0"
                        ToolTip.Tip="Evaluate the C# expression/statements with the script interface as globals (Ctrl+Enter)" />
                <TextBox x:Name="CommandBox" AcceptsReturn="False" FontFamily="Cascadia Mono,DejaVu Sans Mono,Liberation Mono,Consolas,monospace"
                         Watermark="C# command (e.g. Data.Sprites.Count) — press Enter to run" KeyDown="CommandBox_KeyDown" />
            </DockPanel>
        </Border>

        <Grid ColumnDefinitions="320,Auto,*">
            <DockPanel Grid.Column="0" Margin="6,6,0,6">
                <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Watermark="Filter resources..." Margin="0,0,0,6" />
                <ListBox x:Name="ResourceTree" SelectionMode="Single" />
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns" Background="Transparent" />
            <TabControl x:Name="EditorTabs" Grid.Column="2" Margin="0,0,6,6" Padding="8,6,0,0" />
        </Grid>
    </DockPanel>
</Window>
